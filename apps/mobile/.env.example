# Copy to .env (git-ignored) for local development. Every value may stay empty:
# the app starts without Supabase, Sentry, RevenueCat or OneSignal keys (features degrade to no-ops).
# Only EXPO_PUBLIC_* values reach the JS bundle; never put a secret key here.

# Build-time selectors (read by app.config.ts, not bundled)
APP_ENV=
EAS_PROJECT_ID=
SENTRY_ORG=

# Supabase (thuluth-dev / thuluth-staging / thuluth-prod)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry project thuluth-mobile
EXPO_PUBLIC_SENTRY_DSN=

# Google sign-in (11 §5.2). The web client id is the audience Supabase verifies; the iOS client id
# also becomes the reversed URL scheme in app.config.ts. Android needs no id here, only the SHA-1 of
# the signing key registered on an Android OAuth client in the same Google Cloud project.
# Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# hCaptcha site key (public). Set only where Supabase Auth CAPTCHA is enabled (staging, production);
# the app then asks for an hCaptcha token before email-code and password sign-in. Leave empty locally.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=

# Later sprints
EXPO_PUBLIC_ONESIGNAL_APP_ID=
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
